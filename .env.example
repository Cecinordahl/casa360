# ---- Public (Vite-bundled, safe to expose to the browser) ----
# Firebase project config (Project settings -> General -> Your apps -> SDK setup and config).
# Copy this file to .env.local and fill in real values. Never commit .env.local.
VITE_FIREBASE_API_KEY=replace-me
VITE_FIREBASE_AUTH_DOMAIN=replace-me.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-me
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-me
VITE_FIREBASE_APP_ID=replace-me

# ---- Server-only (used by api/*.ts, NEVER prefix these with VITE_) ----
# Anything with a VITE_ prefix gets bundled into the client JS and is
# world-readable — these three below must never get that prefix. They're
# only read by the Vercel serverless functions in api/, either when
# deployed (set these in the Vercel dashboard, not here) or when testing
# locally with `vercel dev` (which reads .env.local same as Vite does).
#
# Cloudinary (Settings -> Access Keys in the Cloudinary console):
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
#
# Firebase service account (Project settings -> Service accounts ->
# Generate new private key -> downloads a JSON file with these three
# fields). This grants full admin access to your Firebase project, so
# treat it like a password — never commit it, never share it.
FIREBASE_PROJECT_ID=replace-me
FIREBASE_CLIENT_EMAIL=replace-me@replace-me.iam.gserviceaccount.com
# Paste the private_key value from the JSON file as-is, including the
# \n sequences and the BEGIN/END lines, wrapped in quotes:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
